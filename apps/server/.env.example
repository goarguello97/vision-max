# Copiar a apps/server/.env y completar. Nunca commitear el .env real.
# Las que hoy valida el scaffold están marcadas con (*); el resto las suma cada módulo al implementarse.

# --- General
NODE_ENV=development
PORT=4000
# (*) Origen del frontend: CORS y links de los mails
APP_URL=http://localhost:5173

# --- Base de datos: Supabase Postgres (pooler)
# (*) Supabase > Project Settings > Database > Connection string > "Transaction pooler"
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# (*) false solo para un Postgres local sin SSL
DATABASE_SSL=true

# --- Supabase Storage (avatares, spec 03)
SUPABASE_URL=https://<ref>.supabase.co
# Secreta: solo en el server, nunca con prefijo VITE_
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATARS_BUCKET=avatars
AVATAR_MAX_BYTES=5242880

# --- TMDB (spec 02)
# Token v4 de lectura: themoviedb.org > Settings > API > "API Read Access Token"
TMDB_API_TOKEN=
TMDB_LANGUAGE=es-ES
TMDB_REGION=AR
CATALOG_MEMORY_CACHE_MAX=500
CATALOG_CLEANUP_CRON=0 4 * * *

# --- Auth (spec 01)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ONBOARDING_JWT_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=false
BCRYPT_COST=12
RESET_TOKEN_TTL_MIN=60
GOOGLE_CLIENT_ID=

# --- Mail (SMTP). En desarrollo: el servicio mailpit del docker compose (UI en http://localhost:8025).
# Sin SMTP_HOST no se envía nada y el link de recuperación solo se imprime en la consola del server.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vision Max <no-reply@visionmax.local>"
